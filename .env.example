# Copy to .env.local for local development. Do not commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Postgres (Neon or Vercel Postgres). Server-only. POSTGRES_URL is also accepted.
DATABASE_URL=

# Contact form (Proton Mail SMTP). Server-only. Never use NEXT_PUBLIC_*.
# CONTACT_SMTP_PASSWORD is the Proton-generated SMTP token, not the account password.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_DESTINATION_EMAIL=
