# Copy to .env.local for local development. Do not commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Postgres (Neon or Vercel Postgres). Server-only. POSTGRES_URL is also accepted.
DATABASE_URL=

# Server-side SMTP for Contact messages and order request notifications.
# Never use NEXT_PUBLIC_* for these values.
# CONTACT_SMTP_PASSWORD is the SMTP token, not a public account password.
# CONTACT_DESTINATION_EMAIL should be support@banditgenetics.com.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_DESTINATION_EMAIL=
