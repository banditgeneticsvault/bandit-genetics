# Copy to .env.local for local development. Do not commit .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Postgres (Neon or Vercel Postgres). Server-only. POSTGRES_URL is also accepted.
DATABASE_URL=

# Server-side Proton SMTP for Contact and order request notifications.
# Never use NEXT_PUBLIC_* for these values.
# CONTACT_SMTP_PASSWORD must be a Proton SMTP token, not the Proton account password.
# Generate it in Proton Mail: Settings → All settings → IMAP/SMTP → SMTP tokens.
# Pair the token with support@banditgenetics.com.
CONTACT_SMTP_HOST=smtp.protonmail.ch
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=support@banditgenetics.com
CONTACT_SMTP_PASSWORD=
EMAIL_FROM=support@banditgenetics.com
CONTACT_DESTINATION_EMAIL=support@banditgenetics.com
